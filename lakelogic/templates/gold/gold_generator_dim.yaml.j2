# ============================================================
# LAKELOGIC DATA CONTRACT — GOLD LAYER (GENERATOR DIMENSION)
# Generated by Build with Zeus from template: gold_generator_dim
# Engine-agnostic: external_logic supplies the rows; no upstream
# data, just a bootstrap seed and a Python generator.
# ============================================================

version: "1.0.0"

info:
  title: "{{ title }}"
  description: "{{ description | default('Reference/lookup dimension materialized entirely by a Python generator (no upstream source).') }}"
  target_layer: "gold"
  domain: "{{ domain }}"
  system: "{{ system }}"
  table_name: "{{ table_name }}"

primary_key: {{ primary_key | tojson }}

model:
  fields:
{%- for field in fields %}
    - name: "{{ field.name }}"
      type: "{{ field.type | default('string') }}"
{%- if field.required %}
      required: true
{%- endif %}
{%- if field.description %}
      description: "{{ field.description }}"
{%- endif %}
{%- endfor %}

# Bootstrap source: empty seed (header-only CSV) so the pipeline has a valid
# source DataFrame to operate on. The actual rows are produced by the
# generator below.
source:
  type: "landing"
  path: "{{ seed_path | default('{landing_root}/' + dataset_name + '_seed') }}"
  format: "csv"
  options:
    header: "true"
  load_mode: "full"
  watermark_strategy: "none"

# Path is resolved relative to the contract YAML's directory (_base_path).
external_logic:
  type: "python"
  path: "{{ generator_path }}"
  entrypoint: "{{ generator_entrypoint | default('run') }}"
{%- if generator_args %}
  args:
{%- for k, v in generator_args.items() %}
    {{ k }}: {{ v | tojson }}
{%- endfor %}
{%- endif %}

quality:
  dataset_rules:
{%- for pk in primary_key %}
    - unique: "{{ pk }}"
{%- endfor %}
{%- if quality.row_count_min is defined %}
    - row_count_between:
        min: {{ quality.row_count_min }}
{%- endif %}

materialization:
  strategy: "{{ materialization_strategy | default('overwrite') }}"
  format: "{{ materialization_format | default('delta') }}"

{%- if owner %}

# ── Governance ──
owner: "{{ owner }}"
{%- endif %}
{%- if sla %}
sla:
  freshness: "{{ sla.freshness | default('P30D') }}"
  retention: "{{ sla.retention | default('P7Y') }}"
{%- endif %}
