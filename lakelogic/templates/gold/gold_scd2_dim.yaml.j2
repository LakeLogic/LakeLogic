# ============================================================
# LAKELOGIC DATA CONTRACT — GOLD LAYER (SCD2 DIMENSION)
# Generated by Build with Zeus from template: gold_scd2_dim
# Engine-agnostic: materialization.strategy drives behaviour;
# no engine pin lives in this contract.
# ============================================================

version: "1.0.0"

info:
  title: "{{ title }}"
  description: "{{ description | default('Slowly Changing Dimension (Type 2) — tracks history of tracked attributes.') }}"
  target_layer: "gold"
  domain: "{{ domain }}"
  system: "{{ system }}"
  table_name: "{{ table_name }}"

{%- if upstream_contracts %}
upstream_contracts:
{%- for u in upstream_contracts %}
  - contract: "{{ u.contract }}"
    layer: "{{ u.layer | default('silver') }}"
{%- if u.domain %}
    domain: "{{ u.domain }}"
{%- endif %}
{%- if u.system %}
    system: "{{ u.system }}"
{%- endif %}
{%- endfor %}
{%- endif %}

# Business key — stable across SCD2 versions. Surrogate key is generated by
# the materializer (NOT modeled in source) and is unique per version.
primary_key: {{ primary_key | tojson }}
natural_key: {{ natural_key | tojson }}

source:
  type: "{{ source_type | default('delta') }}"
  path: "{{ source_path }}"
  load_mode: "{{ load_mode | default('incremental') }}"
  watermark_strategy: "{{ watermark_strategy | default('pipeline_log') }}"

model:
  fields:
    # ── Surrogate + business keys ──
    - name: "{{ scd2.surrogate_key }}"
      type: "long"
      required: true
      description: "Surrogate key; new for each SCD2 version (generated by materializer)."
    - name: "{{ business_key }}"
      type: "string"
      required: true
      description: "Business key — stable across versions."
{%- for field in tracked_fields %}
    - name: "{{ field.name }}"
      type: "{{ field.type | default('string') }}"
{%- if field.pii %}
      pii: true
{%- if field.masking %}
      masking: "{{ field.masking }}"
{%- endif %}
{%- endif %}
{%- if field.description %}
      description: "{{ field.description }}"
{%- endif %}
{%- endfor %}
{%- for field in informational_fields %}
    - name: "{{ field.name }}"
      type: "{{ field.type | default('string') }}"
{%- if field.pii %}
      pii: true
{%- if field.masking %}
      masking: "{{ field.masking }}"
{%- endif %}
{%- endif %}
{%- if field.description %}
      description: "{{ field.description }}"
{%- endif %}
{%- endfor %}
    # ── SCD2 mechanics (injected by materializer; declared here so consumers can plan against the schema) ──
    - name: "{{ scd2.timestamp_field }}"
      type: "timestamp"
      description: "Source-side timestamp that drives version cuts."
    - name: "{{ scd2.effective_from_field | default('effective_from') }}"
      type: "timestamp"
      required: true
      description: "When this version became current."
    - name: "{{ scd2.effective_to_field | default('effective_to') }}"
      type: "timestamp"
      description: "Closed when superseded; NULL for current."
    - name: "{{ scd2.current_flag_field | default('is_current') }}"
      type: "boolean"
      required: true
      description: "TRUE for the active version."
    - name: "version_number"
      type: "int"
      description: "1, 2, 3... per business key."

# Project source columns into the dim's attribute set and alias the source
# timestamp column into the SCD2 driver field.
transformations:
  - phase: pre
    sql: |
{{ pre_sql | indent(6, true) }}

materialization:
  strategy: scd2
  format: delta
  scd2:
    surrogate_key: "{{ scd2.surrogate_key }}"
    surrogate_key_strategy: "{{ scd2.surrogate_key_strategy | default('hash') }}"
    timestamp_field: "{{ scd2.timestamp_field }}"
    effective_from_field: "{{ scd2.effective_from_field | default('effective_from') }}"
    effective_to_field: "{{ scd2.effective_to_field | default('effective_to') }}"
    current_flag_field: "{{ scd2.current_flag_field | default('is_current') }}"
    version_column: "version_number"
    track_columns: {{ scd2.track_columns | tojson }}
{%- if scd2.unknown_member_enabled %}
    unknown_member:
      enabled: true
      surrogate_key_value: "{{ scd2.unknown_member_sk | default('-1') }}"
{%- endif %}

quality:
  dataset_rules:
    - unique: "{{ scd2.surrogate_key }}"
{%- if quality.row_count_min is defined %}
    - row_count_between:
        min: {{ quality.row_count_min }}
{%- endif %}

{%- if owner %}

# ── Governance ──
owner: "{{ owner }}"
{%- endif %}
{%- if sla %}
sla:
  freshness: "{{ sla.freshness | default('P1D') }}"
  retention: "{{ sla.retention | default('P7Y') }}"
{%- endif %}
