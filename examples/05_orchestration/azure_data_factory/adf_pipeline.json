{
  "name": "lakelogic_adf_pipeline",
  "properties": {
    "activities": [
      {
        "name": "RunReference",
        "type": "Custom",
        "dependsOn": [],
        "typeProperties": {
          "command": "lakelogic-driver",
          "args": [
            "--registry", "adls://code/examples/insurance_elt/contracts/insurance/_registry.yaml",
            "--reference-registry", "adls://code/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
            "--gold-registry", "adls://code/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
            "--layers", "reference",
            "--window", "last_success",
            "--summary-table", "lakelogic.pipeline_runs",
            "--summary-backend", "duckdb",
            "--summary-database", "adls://code/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
            "--metrics-path", "adls://code/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
          ]
        }
      },
      {
        "name": "RunBronze",
        "type": "Custom",
        "dependsOn": [{"activity": "RunReference", "dependencyConditions": ["Succeeded"]}],
        "typeProperties": {
          "command": "lakelogic-driver",
          "args": [
            "--registry", "adls://code/examples/insurance_elt/contracts/insurance/_registry.yaml",
            "--reference-registry", "adls://code/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
            "--gold-registry", "adls://code/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
            "--layers", "bronze",
            "--window", "last_success",
            "--summary-table", "lakelogic.pipeline_runs",
            "--summary-backend", "duckdb",
            "--summary-database", "adls://code/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
            "--metrics-path", "adls://code/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
          ]
        }
      },
      {
        "name": "RunSilver",
        "type": "Custom",
        "dependsOn": [{"activity": "RunBronze", "dependencyConditions": ["Succeeded"]}],
        "typeProperties": {
          "command": "lakelogic-driver",
          "args": [
            "--registry", "adls://code/examples/insurance_elt/contracts/insurance/_registry.yaml",
            "--reference-registry", "adls://code/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
            "--gold-registry", "adls://code/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
            "--layers", "silver",
            "--window", "last_success",
            "--summary-table", "lakelogic.pipeline_runs",
            "--summary-backend", "duckdb",
            "--summary-database", "adls://code/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
            "--metrics-path", "adls://code/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
          ]
        }
      },
      {
        "name": "RunGold",
        "type": "Custom",
        "dependsOn": [{"activity": "RunSilver", "dependencyConditions": ["Succeeded"]}],
        "typeProperties": {
          "command": "lakelogic-driver",
          "args": [
            "--registry", "adls://code/examples/insurance_elt/contracts/insurance/_registry.yaml",
            "--reference-registry", "adls://code/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
            "--gold-registry", "adls://code/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
            "--layers", "gold",
            "--window", "last_success",
            "--summary-table", "lakelogic.pipeline_runs",
            "--summary-backend", "duckdb",
            "--summary-database", "adls://code/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
            "--metrics-path", "adls://code/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
          ]
        }
      }
    ]
  }
}
