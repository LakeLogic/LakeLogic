{
  "Comment": "LakeLogic pipeline on AWS Step Functions",
  "StartAt": "RunReference",
  "States": {
    "RunReference": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "lakelogic-reference",
        "Arguments": {
          "--REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/_registry.yaml",
          "--REF_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
          "--GOLD_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
          "--LAYERS": "reference",
          "--WINDOW": "last_success",
          "--SUMMARY_TABLE": "lakelogic.pipeline_runs",
          "--SUMMARY_BACKEND": "duckdb",
          "--SUMMARY_DATABASE": "s3://your-bucket/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
          "--METRICS_PATH": "s3://your-bucket/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
        }
      },
      "Next": "RunBronze"
    },
    "RunBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "lakelogic-bronze",
        "Arguments": {
          "--REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/_registry.yaml",
          "--REF_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
          "--GOLD_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
          "--LAYERS": "bronze",
          "--WINDOW": "last_success",
          "--SUMMARY_TABLE": "lakelogic.pipeline_runs",
          "--SUMMARY_BACKEND": "duckdb",
          "--SUMMARY_DATABASE": "s3://your-bucket/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
          "--METRICS_PATH": "s3://your-bucket/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
        }
      },
      "Next": "RunSilver"
    },
    "RunSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "lakelogic-silver",
        "Arguments": {
          "--REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/_registry.yaml",
          "--REF_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
          "--GOLD_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
          "--LAYERS": "silver",
          "--WINDOW": "last_success",
          "--SUMMARY_TABLE": "lakelogic.pipeline_runs",
          "--SUMMARY_BACKEND": "duckdb",
          "--SUMMARY_DATABASE": "s3://your-bucket/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
          "--METRICS_PATH": "s3://your-bucket/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
        }
      },
      "Next": "RunGold"
    },
    "RunGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "lakelogic-gold",
        "Arguments": {
          "--REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/_registry.yaml",
          "--REF_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/shared/reference/_registry.yaml",
          "--GOLD_REGISTRY": "s3://your-bucket/examples/insurance_elt/contracts/insurance/warehouse/_registry.yaml",
          "--LAYERS": "gold",
          "--WINDOW": "last_success",
          "--SUMMARY_TABLE": "lakelogic.pipeline_runs",
          "--SUMMARY_BACKEND": "duckdb",
          "--SUMMARY_DATABASE": "s3://your-bucket/examples/insurance_elt/output/run_logs/lakelogic_pipeline_runs.duckdb",
          "--METRICS_PATH": "s3://your-bucket/examples/insurance_elt/output/run_logs/pipeline_metrics.json"
        }
      },
      "End": true
    }
  }
}
