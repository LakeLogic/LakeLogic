"""
Bronze – {{ title }}
{{ '=' * (title | length + 9) }}
{{ description }}

Source: {{ source_name }} ({{ source_system }})
Output: Bronze table with all fields cast to string for schema-safe landing.

Called by lakelogic via external_logic in {{ contract_filename }}.
Generated by Zeus AI from template: bronze_ingest_processor.
"""

from __future__ import annotations

from datetime import datetime, timezone

import polars as pl


def run(
    good_df,
    *,
    contract=None,
    engine: str = "polars",
    **_kwargs,
):
    """
    LakeLogic external_logic entrypoint — Bronze Ingestion.

    Casts all columns to Utf8 (string) for schema-safe landing.
    Adds metadata columns for traceability.

    Parameters
    ----------
    good_df : DataFrame
        Raw source records that passed quality rules.
    """
    # ── Coerce to Polars ──────────────────────────────────────────────────
    df = _to_polars(good_df)

    # ── Cast all columns to string ────────────────────────────────────────
    df = df.cast({col: pl.Utf8 for col in df.columns})

    # ── Add audit/metadata columns ────────────────────────────────────────
    df = df.with_columns(
        pl.lit(datetime.now(timezone.utc).replace(microsecond=0)).alias("_bronze_loaded_at"),
        pl.lit("{{ source_system }}").alias("_source_system"),
    )

    return _maybe_to_spark(df, engine)


# ── Helpers ───────────────────────────────────────────────────────────────────


def _to_polars(df) -> pl.DataFrame:
    """Convert any DataFrame to Polars."""
    if isinstance(df, pl.DataFrame):
        return df
    if hasattr(df, "toPandas"):
        return pl.from_pandas(df.toPandas())
    return pl.from_pandas(df)


def _maybe_to_spark(df: pl.DataFrame, engine: str):
    """Convert back to Spark if needed."""
    if engine == "spark":
        try:
            from pyspark.sql import SparkSession
            spark = SparkSession.builder.getOrCreate()
            return spark.createDataFrame(df.to_pandas())
        except Exception:
            pass
    return df
