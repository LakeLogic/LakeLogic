[run]
omit =
    # Exclude experimental adapters and wrappers
    lakelogic/adapters/*
    
    # Exclude tooling scripts
    lakelogic/tools/*
    
    # Exclude AI module
    lakelogic/ai/*

    # Exclude integration-heavy runtime validators/adapters
    lakelogic/core/slo.py
    lakelogic/engines/polars.py
