    "notifications_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notifications Enabled"
    },
    "observatory": {
      "additionalProperties": true,
      "title": "Observatory",
      "type": "object"
    },
    "ownership": {
      "additionalProperties": true,
      "title": "Ownership",
      "type": "object"
    },
    "quarantine": {
      "additionalProperties": true,
      "title": "Quarantine",
      "type": "object"
    },
    "retention": {
      "additionalProperties": true,
      "title": "Retention",
      "type": "object"
    },
    "server": {
      "additionalProperties": true,
      "title": "Server",
      "type": "object"
    },
    "silver_layer": {
      "default": "silver",
      "title": "Silver Layer",
      "type": "string"
    },
    "slo": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistrySLO"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
