    "SLORowCountAnomalyConfig": {
      "description": "Anomaly detection against historical run log baselines.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "lookback_runs": {
          "default": 14,
          "title": "Lookback Runs",
          "type": "integer"
