        "max_ratio": {
          "default": 2.0,
          "title": "Max Ratio",
          "type": "number"
        },
        "method": {
          "default": "median",
          "title": "Method",
          "type": "string"
        },
        "min_ratio": {
          "default": 0.5,
          "title": "Min Ratio",
          "type": "number"
        },
        "min_runs_before_enforcement": {
          "default": 5,
          "title": "Min Runs Before Enforcement",
          "type": "integer"
        }
      },
      "title": "SLORowCountAnomalyConfig",
      "type": "object"
    },
    "SLORowCountConfig": {
      "description": "Per-layer row count thresholds checked against run log entries.",
      "properties": {
        "anomaly": {
          "anyOf": [
            {
              "$ref": "#/$defs/SLORowCountAnomalyConfig"
