# Secrets Template
# DO NOT commit this file with actual values!
# Copy this to `secrets.auto.tfvars` for local development
# Add `*.auto.tfvars` to .gitignore

# These values should be provided via:
# 1. Environment variables (TF_VAR_*) in CI/CD
# 2. secrets.auto.tfvars for local development (git-ignored)
# 3. External secret management (Azure Key Vault, HashiCorp Vault, etc.)

# Azure Authentication (provided by OIDC in CI/CD)
subscription_id = "00000000-0000-0000-0000-000000000000"  # Your Azure subscription ID
tenant_id       = "00000000-0000-0000-0000-000000000000"  # Your Azure tenant ID

# GitHub Service Principal (for Key Vault access)
github_sp_object_id = "00000000-0000-0000-0000-000000000000"  # GitHub Actions SP object ID

# Database Credentials
db_admin_password = "CHANGE-ME-SecurePassword123!"  # Strong password for PostgreSQL admin

# Windows Jump Server RDP Password
jumpbox_admin_password = "CHANGE-ME-ComplexPassword123$"  # min 12 chars, must include uppercase, lowercase, number, special char

# Notes:
# - Use strong passwords (min 12/16 chars, mixed case, numbers, symbols)
# - Rotate secrets regularly
# - Never commit actual secrets to git
# - In production, use managed identities where possible
