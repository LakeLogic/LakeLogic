# Project Metadata
project_name = "lineagelogic"
environment  = "prod"
location     = "eastus"

# Authentication (Required)
subscription_id = "your-azure-subscription-id"
tenant_id       = "your-azure-tenant-id"

# Database Configuration
db_admin_login    = "lladmin"
db_admin_password = "ReplaceWithAStrongPassword123!"
db_sku            = "Standard_D2ds_v4"

# Networking Overrides (Optional)
# networking_config = {
#   vnet_address_space             = ["10.0.0.0/16"]
#   aca_subnet_prefix             = ["10.0.0.0/23"]
#   db_subnet_prefix              = ["10.0.2.0/24"]
#   private_endpoint_subnet_prefix = ["10.0.3.0/24"]
# }

# Hardware Allocation (Optional)
# compute_config = {
#   cpu    = 1.0
#   memory = "2.0Gi"
# }

# Governance Tags
tags = {
  Project      = "LineageLogic"
  ManagedBy    = "Terraform"
  CostCenter   = "SaaS-Execution"
  Architecture = "Sole-Azure"
}
